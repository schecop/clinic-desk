# Copy to .env (gitignored) and fill. Never put real values in this file.

# LLMs: one key per provider used; the model per role is in config (llm:).
# Keys are created for this project only, never reused from another one.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
# Free tier for the persona, if verified (only one of them is needed)
# GROQ_API_KEY=
# CEREBRAS_API_KEY=

# Tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Google Calendar (OAuth client of type "Desktop app"; the token is stored in token.json, gitignored)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
